# MongoDB Connection (Local or Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/Stockvision?retryWrites=true&w=majority&appName=LinkUp
MONGO_DB_NAME=Stockvision
MONGO_COLLECTION_NAME=stockvison user

# Redis URL
REDIS_URL=redis://127.0.0.1:6379/0

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here

# Finnhub API Key
FINNHUB_API_KEY=your_finnhub_api_key_here

# Port
PORT=5000
FLASK_ENV=development
